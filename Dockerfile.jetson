ARG IMAGE=base
FROM ${IMAGE}

RUN mkdir -p /opt/nvidia/l4t-packages && \
  touch /opt/nvidia/l4t-packages/.nv-l4t-disable-boot-fw-update-in-preinstall

# Disable ISCSI
# (The kernel does not support it: https://github.com/kairos-io/kairos/issues/2467)
RUN echo 'omit_dracutmodules+=" iscsi "' > /etc/dracut.conf.d/iscsi.conf

RUN apt-key adv --fetch-key http://repo.download.nvidia.com/jetson/jetson-ota-public.asc && \
  echo "deb https://repo.download.nvidia.com/jetson/common r36.5 main" | sudo tee -a /etc/apt/sources.list.d/nvidia-l4t-apt-source.list && \
  echo "deb https://repo.download.nvidia.com/jetson/t234 r36.5 main" | sudo tee -a /etc/apt/sources.list.d/nvidia-l4t-apt-source.list && \
  apt-get update && apt-get install -y --no-install-recommends \
  nvidia-cudnn=6.2.2+b24 \
  nvidia-jetpack-runtime \
  # The kernel and display packages are needed for the nvidia runtime to work, as it relies on the nvidia modules being present in the kernel, and the display package includes the nvidia-uvm module which is also required
  nvidia-l4t-kernel \
  nvidia-l4t-kernel-oot-modules \
  nvidia-l4t-display-kernel \
  nvidia-l4t-firmware \
  nvidia-l4t-bootloader \
  nvidia-l4t-configs \
  nvidia-l4t-tools && \
  apt-get clean && rm -rf /var/lib/apt/lists/* && \
  # Move CUDA out of the way to /opt so kairos can occupy /usr/local without workarounds
  update-alternatives --remove-all cuda && \
  update-alternatives --remove-all cuda-12 && \
  mv /usr/local/cuda-12.6 /opt/cuda-12.6 && \
  update-alternatives --install /opt/cuda cuda /opt/cuda-12.6 1 && \
  update-alternatives --install /opt/cuda-12 cuda-12 /opt/cuda-12.6 1

# Detect tegra kernel version and set up symlinks for kairos to use
RUN TEGRA_VER=$(ls /lib/modules 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+-tegra' | sort -V | tail -n1) && \
  if [ -z "$TEGRA_VER" ]; then \
  echo "ERROR: tegra kernel not found in /lib/modules" && exit 1; \
  fi && \
  echo "Found tegra kernel version: $TEGRA_VER" && \
  ln -sf /boot/Image "/boot/vmlinuz-${TEGRA_VER}" && \
  ln -sf /boot/Image /boot/vmlinuz && \
  echo "$TEGRA_VER" > /tmp/tegra_version.txt && \
  depmod "$TEGRA_VER"

# Force initrd rebuild for the tegra kernel, writing to /boot/initrd which is the
# path the bootloader (GRUB/kairos) actually loads. Without the explicit output path,
# dracut writes to /boot/initramfs-<version>.img which is never loaded.
RUN TEGRA_VER=$(cat /tmp/tegra_version.txt) && \
  dracut -f /boot/initrd --kver "$TEGRA_VER" && \
  echo "Rebuilt /boot/initrd for kernel $TEGRA_VER" && \
  lsinitrd /boot/initrd | grep -E 'nvme|blkid|by-label|persistent-storage' || true

# setup container to use the nvidia runtime by default
RUN nvidia-ctk runtime configure --runtime=containerd --cdi.enable
# create the cdi file (csv because some strange mapping issues otherwise)
# TODO -> I think this needs to run on the device, so in startup script
RUN nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml --mode=csv
# we need to link runc to /usr/bin for the nvidia runtime to work, as it is hardcoded to look for it there
# I think kairos, or the operator puts this in another location
RUN ln -sf /opt/bin/runc /usr/bin/runc

# FOR TESTING PURPOSES ONLY, NOT FOR PRODUCTION
# with nerdclt we can quikcly test containerd locally e.g. with `sudo nerdctl run --rm --device nvidia.com/gpu=all  nvcr.io/nvidia/k8s/cuda-sample:devicequery`
# RUN apt-get update && apt-get install -y --no-install-recommends \
#     ca-certificates \
#     wget \
#     tar && \
#     mkdir -p /opt/bin && \
#     wget -q https://github.com/containerd/nerdctl/releases/download/v2.2.1/nerdctl-2.2.1-linux-arm64.tar.gz && \
#     tar -xzf nerdctl-2.2.1-linux-arm64.tar.gz -C /opt/bin nerdctl && \
#     chmod +x /opt/bin/nerdctl && \
#     ln -sf /opt/bin/nerdctl /usr/bin/nerdctl && \
#     rm -f nerdctl-2.2.1-linux-arm64.tar.gz && \
#     apt-get clean && rm -rf /var/lib/apt/lists/*
